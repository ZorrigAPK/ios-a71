From: ZorrigAPK <ZorrigAPK@users.noreply.github.com>
Subject: [PATCH] a71: USB network as CDC-NCM (Windows inbox driver), link-local address

Boot 11 enumerated as "Sweet iOS (USB Ethernet)" but Windows has no
CDC-ECM driver (code 28). Windows 10 2004+/11 ship UsbNcm.sys for
CDC-NCM: switch the descriptors to NCM, answer the NCM class requests
(NTB parameters, input size, format) and frame RX/TX as one-datagram
NTB16 blocks. ue0 becomes 169.254.7.2/16 so it shares the subnet Windows
picks for an adapter without DHCP; the live log goes to the broadcast
address 169.254.255.255:5140.

---
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 4e7059e..a7807cc 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -24,6 +24,7 @@
 #include <kern/locks.h>
 #include <sys/kpi_mbuf.h>
 #include <sys/kpi_socket.h>
+#include <sys/socket.h>
 #include <sys/sockio.h>
 #include <net/if.h>
 #include <net/if_types.h>
@@ -490,15 +491,20 @@ static const uint8_t ud_dev_desc[18] = {
 	18, 1, 0x00, 0x02, 0x02, 0x00, 0x00, 64,
 	0x09, 0x12, 0x01, 0x00, 0x00, 0x01, 1, 2, 3, 1,
 };
-static const uint8_t ud_cfg_desc[80] = {
-	9, 2, 80, 0, 2, 1, 0, 0x80, 250,                /* config: 2 interfaces, 500 mA */
-	9, 4, 0, 0, 1, 0x02, 0x06, 0x00, 0,             /* comm interface 0: CDC ECM, 1 endpoint */
+/*
+ * CDC-NCM 1.0 (A71): Windows 10 2004+/11 bind their inbox UsbNcm driver
+ * to it (they have no CDC-ECM driver); Linux uses cdc_ncm, macOS too.
+ */
+static const uint8_t ud_cfg_desc[86] = {
+	9, 2, 86, 0, 2, 1, 0, 0x80, 250,                /* config: 2 interfaces, 500 mA */
+	9, 4, 0, 0, 1, 0x02, 0x0d, 0x00, 0,             /* comm interface 0: CDC NCM, 1 endpoint */
 	5, 0x24, 0x00, 0x10, 0x01,                      /* header, CDC 1.10 */
 	5, 0x24, 0x06, 0, 1,                            /* union: control 0, data 1 */
 	13, 0x24, 0x0f, 4, 0, 0, 0, 0, 0xea, 0x05, 0, 0, 0, /* ethernet: MAC string 4, max segment 1514 */
+	6, 0x24, 0x1a, 0x00, 0x01, 0x00,                /* NCM functional: version 1.00, no optional requests */
 	7, 5, 0x82, 0x03, 16, 0, 9,                     /* ep 0x82 interrupt IN, 16 bytes, 2^(9-1) uframes */
-	9, 4, 1, 0, 0, 0x0a, 0x00, 0x00, 0,             /* data interface 1 alt 0: no endpoints */
-	9, 4, 1, 1, 2, 0x0a, 0x00, 0x00, 0,             /* data interface 1 alt 1: two bulk endpoints */
+	9, 4, 1, 0, 0, 0x0a, 0x00, 0x01, 0,             /* data interface 1 alt 0: no endpoints, NTB protocol */
+	9, 4, 1, 1, 2, 0x0a, 0x00, 0x01, 0,             /* data interface 1 alt 1: two bulk endpoints */
 	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
 	7, 5, 0x01, 0x02, 0x00, 0x02, 0,                /* ep 0x01 bulk OUT, 512 */
 };
@@ -533,6 +539,8 @@ static void ud_rx_arm(void);
 static void ud_tx_kick_locked(void);
 static void ud_link_event(bool up);
 
+static bool ud_speed_pending;
+
 /* NETWORK_CONNECTION notification: the host brings its link up on it. */
 static void
 ud_notify_connected(void)
@@ -543,6 +551,22 @@ ud_notify_connected(void)
 	n[4] = 0; n[5] = 0;             /* interface 0 */
 	n[6] = 0; n[7] = 0;
 	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 8, TRBCTL_NORMAL);
+	ud_speed_pending = true;
+}
+
+/* CONNECTION_SPEED_CHANGE (480 Mb/s both ways), sent once NETWORK_CONNECTION is out. */
+static void
+ud_notify_speed(void)
+{
+	uint8_t *n = (uint8_t *)(ud.dma + UD_NOTIFY);
+	n[0] = 0xa1; n[1] = 0x2a;
+	n[2] = 0; n[3] = 0; n[4] = 0; n[5] = 0; n[6] = 8; n[7] = 0;
+	const uint32_t bps = 480000000u;
+	for (unsigned i = 0; i < 4; i++) {
+		n[8 + i] = n[12 + i] = (uint8_t)(bps >> (8 * i));
+	}
+	ud_speed_pending = false;
+	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 16, TRBCTL_NORMAL);
 }
 
 /* SET_CONFIGURATION(1): bulk IN/OUT and the interrupt endpoint. */
@@ -583,8 +607,25 @@ ud_setup(void)
 
 	printf("SWEET USB: setup %02x %02x %04x %04x len %u\n", type, req, value, index, length);
 	ud.data_in = (type & 0x80) != 0;
-	if ((type & 0x60) == 0x20) {    /* class request (e.g. SET_ETHERNET_PACKET_FILTER) */
-		ok = (length == 0);
+	if ((type & 0x60) == 0x20) {    /* class request */
+		if (req == 0x80 && ud.data_in) {        /* GET_NTB_PARAMETERS */
+			static const uint8_t p[28] = {
+				28, 0, 0x01, 0x00,              /* length, NTB16 only */
+				0x00, 0x08, 0, 0,               /* dwNtbInMaxSize 2048 */
+				4, 0, 0, 0, 4, 0, 0, 0,         /* IN divisor 4, remainder 0, alignment 4, reserved */
+				0x00, 0x08, 0, 0,               /* dwNtbOutMaxSize 2048 (one RX buffer) */
+				4, 0, 0, 0, 4, 0, 1, 0,         /* OUT divisor 4, remainder 0, alignment 4, 1 datagram */
+			};
+			memcpy(data, p, sizeof(p)); n = sizeof(p);
+		} else if (req == 0x85 && ud.data_in) { /* GET_NTB_INPUT_SIZE */
+			data[0] = 0x00; data[1] = 0x08; data[2] = 0; data[3] = 0; n = 4;
+		} else if (req == 0x83 && ud.data_in) { /* GET_NTB_FORMAT: NTB16 */
+			data[0] = 0; data[1] = 0; n = 2;
+		} else {
+			/* SET_ETHERNET_PACKET_FILTER, SET_NTB_FORMAT, SET_NTB_INPUT_SIZE
+			 * (OUT data accepted and ignored: NTBs sent stay <= 2048 bytes). */
+			ok = !ud.data_in;
+		}
 	} else if ((type & 0x60) != 0) {
 		ok = false;
 	} else if (req == 6) {          /* GET_DESCRIPTOR */
@@ -648,6 +689,19 @@ ud_rx_arm(void)
 	ud_start_trb(EP_RX, UD_TRB_RX, UD_RX, UD_FRAME_MAX, TRBCTL_NORMAL);
 }
 
+static void ud_rx_frame(const uint8_t *frame, uint32_t len);
+
+static inline uint16_t
+ud_le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | p[1] << 8);
+}
+
+#define NCM_NTH16_SIG   0x484d434eu     /* "NCMH" */
+#define NCM_NDP16_SIG0  0x304d434eu     /* "NCM0" (no CRC) */
+static unsigned ud_ntb_bad;
+
+/* One received NTB16 (NCM): walk its NDP16 list and input every datagram. */
 static void
 ud_rx_done(void)
 {
@@ -655,6 +709,42 @@ ud_rx_done(void)
 	ud_sync(UD_TRB_RX, 16);
 	uint32_t len = UD_FRAME_MAX - (t[2] & 0xffffff);
 	ud_sync(UD_RX, UD_FRAME_MAX);
+	const uint8_t *b = (const uint8_t *)(ud.dma + UD_RX);
+	uint32_t sig = (uint32_t)ud_le16(b) | (uint32_t)ud_le16(b + 2) << 16;
+	uint16_t block = ud_le16(b + 8), ndp = ud_le16(b + 10);
+	bool good = len >= 12 && sig == NCM_NTH16_SIG && block <= len;
+	for (unsigned guard = 0; good && ndp != 0 && guard < 8; guard++) {
+		if (ndp + 16u > block) {
+			good = false;
+			break;
+		}
+		const uint8_t *d = b + ndp;
+		uint32_t dsig = (uint32_t)ud_le16(d) | (uint32_t)ud_le16(d + 2) << 16;
+		uint16_t dlen = ud_le16(d + 4);
+		if ((dsig & 0x00ffffffu) != (NCM_NDP16_SIG0 & 0x00ffffffu) || dlen < 16 || ndp + dlen > block) {
+			good = false;
+			break;
+		}
+		for (uint32_t e = 8; e + 4 <= dlen; e += 4) {
+			uint16_t off = ud_le16(d + e), flen = ud_le16(d + e + 2);
+			if (off == 0 || flen == 0) {
+				break;
+			}
+			if ((uint32_t)off + flen <= block) {
+				ud_rx_frame(b + off, flen);
+			}
+		}
+		ndp = ud_le16(d + 6);
+	}
+	if (!good && ud_ntb_bad++ < 10) {
+		printf("SWEET USB: bad NTB len %u sig %#x block %u ndp %u\n", len, sig, block, ndp);
+	}
+	ud_rx_arm();
+}
+
+static void
+ud_rx_frame(const uint8_t *frame, uint32_t len)
+{
 	if (ud.ifp != NULL && len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN) {
 		/*
 		 * One mbuf with a 2 KiB cluster holds any frame. (mbuf_allocpacket
@@ -666,7 +756,7 @@ ud_rx_done(void)
 		    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
 		    (mbuf_flags(m) & MBUF_EXT) && mbuf_maxlen(m) >= len) {
 			struct ifnet_stat_increment_param stats = {};
-			memcpy(mbuf_data(m), (const void *)(ud.dma + UD_RX), len);
+			memcpy(mbuf_data(m), frame, len);
 			mbuf_setlen(m, len);
 			mbuf_pkthdr_setlen(m, len);
 			void *frame_header = mbuf_data(m);
@@ -682,7 +772,6 @@ ud_rx_done(void)
 			mbuf_freem(m);
 		}
 	}
-	ud_rx_arm();
 }
 
 /* Start the next queued frame if the IN endpoint is idle. ud.lock held. */
@@ -698,16 +787,31 @@ ud_tx_kick_locked(void)
 			mbuf_freem(m);
 			continue;
 		}
-		mbuf_copydata(m, 0, len, (void *)(ud.dma + UD_TX));
+		/*
+		 * One datagram per NTB16: NTH16 at 0, NDP16 at 12, datagram at 32
+		 * (IN divisor 4). A block of a multiple of 512 bytes would need a
+		 * zero-length packet; one pad byte inside the block avoids it.
+		 */
+		uint8_t *b = (uint8_t *)(ud.dma + UD_TX);
+		mbuf_copydata(m, 0, len, b + 32);
 		mbuf_freem(m);
-		/* A frame of a multiple of 512 bytes would need a zero-length
-		 * packet to end it; one pad byte does the same (IP ignores it). */
-		if ((len % 512) == 0) {
-			((uint8_t *)(ud.dma + UD_TX))[len++] = 0;
+		uint32_t block = 32 + (uint32_t)len;
+		if ((block % 512) == 0) {
+			b[block++] = 0;
 		}
+		static uint16_t seq;
+		const uint8_t hdr[32] = {
+			'N', 'C', 'M', 'H', 12, 0, (uint8_t)seq, (uint8_t)(seq >> 8),
+			(uint8_t)block, (uint8_t)(block >> 8), 12, 0,
+			'N', 'C', 'M', '0', 16, 0, 0, 0,
+			32, 0, (uint8_t)len, (uint8_t)(len >> 8), 0, 0, 0, 0,
+			0, 0, 0, 0,
+		};
+		seq++;
+		memcpy(b, hdr, sizeof(hdr));
 		ud.tx_busy = true;
 		ud.tx_frames++;
-		ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, (uint32_t)len, TRBCTL_NORMAL);
+		ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, block, TRBCTL_NORMAL);
 	}
 }
 
@@ -841,20 +945,25 @@ ud_if_create(void)
 		struct sockaddr_in *a = (struct sockaddr_in *)&ifra.ifra_addr;
 		a->sin_len = sizeof(*a);
 		a->sin_family = AF_INET;
-		a->sin_addr.s_addr = htonl(0xc0a80702);         /* 192.168.7.2 */
+		/*
+		 * Link-local 169.254.7.2/16: a Windows/macOS host without DHCP on
+		 * this adapter gives itself 169.254.x.y/16, so both ends share a
+		 * subnet with no configuration on the PC.
+		 */
+		a->sin_addr.s_addr = htonl(0xa9fe0702);         /* 169.254.7.2 */
 		a = (struct sockaddr_in *)&ifra.ifra_mask;
 		a->sin_len = sizeof(*a);
 		a->sin_family = AF_INET;
-		a->sin_addr.s_addr = htonl(0xffffff00);
+		a->sin_addr.s_addr = htonl(0xffff0000);
 		a = (struct sockaddr_in *)&ifra.ifra_broadaddr;
 		a->sin_len = sizeof(*a);
 		a->sin_family = AF_INET;
-		a->sin_addr.s_addr = htonl(0xc0a807ff);
+		a->sin_addr.s_addr = htonl(0xa9feffff);
 		err = sock_ioctl(so, SIOCAIFADDR, &ifra);
 		sock_close(so);
 	}
 	ifnet_set_flags(ud.ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
-	printf("SWEET USB: ue0 192.168.7.2/24 %s (err %d)\n", err ? "NOT configured" : "up", err);
+	printf("SWEET USB: ue0 169.254.7.2/16 %s (err %d)\n", err ? "NOT configured" : "up", err);
 }
 
 static void
@@ -893,6 +1002,12 @@ ud_event(uint32_t ev)
 		lck_mtx_unlock(ud.lock);
 		return;
 	}
+	if (ep == EP_INT && type == 1) {
+		if (ud_speed_pending) {
+			ud_notify_speed();
+		}
+		return;
+	}
 	if (ep > 1) {
 		return;
 	}
@@ -956,7 +1071,7 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
 /*
  * Live console log over USB Ethernet: every 100 ms the new bytes of the
  * console ring (bsd/dev/sweet_ufs.c) go as UDP datagrams to
- * 192.168.7.1:5140 (on the PC: nc -ukl 5140). Starts with the last 64 KiB
+ * 169.254.255.255:5140 (A71; sweet used 192.168.7.1). Starts with the last 256 KiB
  * so the boot is included. Nothing here may print (it would feed itself).
  * Boot-arg sweetusblog=0 disables it.
  */
@@ -976,18 +1091,36 @@ ud_log_thread(void *arg __unused, wait_result_t wr __unused)
 	to.sin_len = sizeof(to);
 	to.sin_family = AF_INET;
 	to.sin_port = htons(5140);
-	to.sin_addr.s_addr = htonl(0xc0a80701);         /* 192.168.7.1 */
+	/* A71: broadcast on the link-local subnet (the PC's 169.254.x.y is not known). */
+	to.sin_addr.s_addr = htonl(0xa9feffff);         /* 169.254.255.255 */
+	bool started = false;
 	for (;;) {
 		ud_sleep_ms(100);
 		if (!ud.configured) {
 			continue;
 		}
-		if (so == NULL && sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
-			so = NULL;
-			continue;
+		if (!started) {
+			/* Give the PC time to bring the adapter up (link-local takes ~10-60 s),
+			 * then resend the last 256 KiB so the boot is included. */
+			ud_sleep_ms(45000);
+			uint64_t now = sweet_log_position();
+			pos = now > 262144 ? now - 262144 : 0;
+			started = true;
 		}
-		uint32_t n;
+		if (so == NULL) {
+			if (sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
+				so = NULL;
+				continue;
+			}
+			int one = 1;
+			(void)sock_setsockopt(so, SOL_SOCKET, SO_BROADCAST, &one, sizeof(one));
+		}
+		uint32_t n, burst = 0;
 		while ((n = sweet_log_copy(&pos, chunk, sizeof(chunk))) > 0) {
+			/* The TX queue holds 32 frames and drains ~1 per ms (polled): pace. */
+			if (++burst % 16 == 0) {
+				ud_sleep_ms(25);
+			}
 			struct iovec iov = { .iov_base = chunk, .iov_len = n };
 			struct msghdr msg = {
 				.msg_name = &to, .msg_namelen = sizeof(to),
